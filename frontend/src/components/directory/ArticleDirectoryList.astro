---
import type { PublishedArticleEntry } from "@/utils/content";
import type { TopicDefinition } from "@/data/taxonomy";
import { getPostUrl } from "@/utils/getPostPaths";

interface Props {
  articles: PublishedArticleEntry[];
  topics: TopicDefinition[];
  emptyMessage?: string;
}

const { articles, topics, emptyMessage = "暂无文章。" } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const topicNames = new Map(topics.map(topic => [topic.id, topic.name]));
---

{
  articles.length > 0 ? (
    <ol class="directory-article-list">
      {articles.map(article => (
        <li
          data-article-item
          data-channel={article.channel}
          data-topics={article.topics.join(" ")}
        >
          <div class="directory-article-list__meta">
            <time datetime={article.pubDatetime.toISOString()}>
              {dateFormatter.format(article.pubDatetime)}
            </time>
            <span>{article.kind === "case-study" ? "项目复盘" : "文章"}</span>
          </div>
          <h2>
            <a href={getPostUrl(article.id, Astro.currentLocale)}>
              {article.title}
            </a>
          </h2>
          <p>{article.description}</p>
          <div class="directory-article-list__topics">
            {article.topics.map(topic => (
              <a href={`/topics/${topic}/`}>{topicNames.get(topic) ?? topic}</a>
            ))}
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p class="directory-empty">{emptyMessage}</p>
  )
}
