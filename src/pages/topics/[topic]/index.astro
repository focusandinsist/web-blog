---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ArticleDirectoryList from "@/components/directory/ArticleDirectoryList.astro";
import {
  getPublishedArticles,
  getTopicDirectory,
  type TopicDirectoryItem,
} from "@/utils/content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPublicationSnapshot } from "@/data/djangoArticleSource";
import "@/styles/directory.css";

export const getStaticPaths = (async () => {
  const snapshot = await getPublicationSnapshot();
  const topics = getTopicDirectory(
    getPublishedArticles(snapshot.articles, new Date()),
    snapshot.taxonomy.topics
  );

  return topics.map(topic => ({
    params: { topic: topic.id },
    props: { topic, topics: snapshot.taxonomy.topics },
  }));
}) satisfies GetStaticPaths;

interface Props {
  topic: TopicDirectoryItem;
  topics: Awaited<
    ReturnType<typeof getPublicationSnapshot>
  >["taxonomy"]["topics"];
}

const { topic, topics } = Astro.props;
---

<Layout title={`${topic.name} | 系统工程笔记`} description={topic.description}>
  <Header />
  <main id="main-content" class="directory-page">
    <header class="directory-page__header">
      <p class="directory-page__eyebrow">专题</p>
      <h1>{topic.name}</h1>
      <p class="directory-page__intro">{topic.description}</p>
    </header>

    {
      topic.series.length > 0 && (
        <section class="directory-series" aria-labelledby="topic-series">
          <h2 id="topic-series">阅读系列</h2>
          <ul>
            {topic.series.map(series => (
              <li>
                <a
                  href={getPostUrl(series.articles[0].id, Astro.currentLocale)}
                >
                  {series.id}（{series.articles.length} 篇）
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <ArticleDirectoryList
      articles={topic.articles}
      {topics}
      emptyMessage="这个专题暂时没有文章。"
    />
  </main>
  <Footer />
</Layout>
