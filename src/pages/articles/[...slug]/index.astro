---
import type { GetStaticPaths } from "astro";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import {
  getDjangoArticleSource,
  getPublicationSnapshot,
} from "@/data/djangoArticleSource";
import { getPostSlug } from "@/utils/getPostPaths";
import {
  getFurtherReading,
  getPublishedArticles,
  getSeriesContext,
  getTopicContext,
  type PublishedArticleEntry,
} from "@/utils/content";
import { renderRemoteMarkdown } from "@/utils/remoteMarkdown";

export const getStaticPaths = (async () => {
  const snapshot = await getPublicationSnapshot();
  const articles = getPublishedArticles(snapshot.articles, new Date());

  return articles.map(article => ({
    params: { slug: getPostSlug(article.id) },
    props: { article, taxonomy: snapshot.taxonomy },
  }));
}) satisfies GetStaticPaths;

interface Props {
  article: PublishedArticleEntry;
  taxonomy: Awaited<ReturnType<typeof getPublicationSnapshot>>["taxonomy"];
}

const { article, taxonomy }: Props = Astro.props;
const source = getDjangoArticleSource();
const articles = getPublishedArticles(
  await source.getPublishedArticles(),
  new Date()
);
const topicContext = getTopicContext(articles, article.id);
const seriesContext = getSeriesContext(articles, article.id);
const furtherReading = getFurtherReading(articles, article.id);
const { html, headings } = await renderRemoteMarkdown(
  article.bodyMarkdown,
  article.id,
  source.mediaOrigin
);
const readingMinutes = Math.max(
  1,
  Math.ceil(article.bodyMarkdown.length / 500)
);
---

<ArticleLayout
  {article}
  {headings}
  {topicContext}
  {seriesContext}
  {furtherReading}
  {readingMinutes}
  {taxonomy}
>
  <Fragment set:html={html} />
</ArticleLayout>
