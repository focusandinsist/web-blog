---
import type { PublishedArticleEntry } from "@/utils/content";
import { getPostUrl } from "@/utils/getPostPaths";

interface Props {
  articles: PublishedArticleEntry[];
}

const { articles } = Astro.props;
---

{
  articles.length > 0 && (
    <section class="article-end-section" aria-label="延伸阅读">
      <h2>延伸阅读</h2>
      <ul>
        {articles.slice(0, 3).map(article => (
          <li>
            <a
              href={getPostUrl(
                article.id,
                article.filePath,
                Astro.currentLocale
              )}
            >
              {article.data.title}
            </a>
            <p>{article.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
