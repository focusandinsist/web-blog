# Django runtime
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_PUBLIC_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/web_blog
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_URL=/media/
DJANGO_STATIC_ROOT=staticfiles
# Enable for managed PostgreSQL in production; disable only for local PostgreSQL.
DJANGO_DATABASE_SSL_REQUIRE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_COOKIES=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Optional deployment settings
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
